  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Measure micro-level GEMM and Conv2d kernel latency/TFLOPs"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates local gemm.py and conv2d.py RESULT parse. Official TorchBench runners are not executed"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: GEMM execution time, us (gemm_time_usec); #2: GEMM throughput, TFLOPS (gemm_tflops); #3: GEMM minimum traffic, GB/s (gemm_bandwidth_gb_s); #4: Conv2d execution time, us (conv_time_usec); #5: Conv2d throughput, TFLOPS (conv_tflops); #6: Conv2d minimum traffic, GB/s (conv_bandwidth_gb_s)"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run scripts/gemm.py and scripts/conv2d.py. Official TorchBench model runners are not executed"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run local scripts/gemm.py for GEMM (C = A x B) and scripts/conv2d.py for Conv2d on yaml M/N/K and input_shape, parse time/TFLOPS/bandwidth, and write kernel CSV rows, to measure PyTorch ROCm microkernel performance. This is not TorchBench run.py"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run local scripts/gemm.py for GEMM and scripts/conv2d.py for Conv2d on yaml M, N, K and input shapes, parse time, TFLOPS, and bandwidth, and write kernel CSV rows. This is not TorchBench run.py"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Runs repository-local scripts/gemm.py and scripts/conv2d.py (PyTorch on ROCm; the same scripts as 219/419) through scripts/collect_torch_micro.py. device_id, dtype, M/N/K, input_shape, warmup_iters, num_iterations, and seed come from yaml; batch_size and kernel_type do not change what runs (both kernels always run). This is not TorchBench. output_format: csv"
  },
  {
